-- COOP_Convoy: campaign mission Convoy hosted as a multiplayer level (CoopMod, make_coop_level.py).
-- Scene = campaign scene + MP_Patrol spawn points / areas / idle cameras at the player start;
-- Events.kt3 = campaign trigger boxes + MP_Patrol's two spawn sectors; Coop_Convoy.lua = co-op adjustments.
DEF_FirstSubLevel = "SubLevel_0"

----------------------------------------------------
--							DEF_GetSubLevelFiles  							
----------------------------------------------------
function DEF_GetSubLevelFiles( SubLevelName )

	if (SubLevelName == "SubLevel_0")
	then
		return "Convoy\\Convoy.Kt3", "Convoy\\OBJ_Voitures_Convoy.Kt3", "Convoy\\OBJ_Antenne_Convoy.Kt3";
	end

end

----------------------------------------------------
--							DEF_GetLevelScriptFiles							
----------------------------------------------------
function DEF_GetLevelScriptFiles( )

	return "Main.lua", "Start.lua", "Start2.lua", "Start3.lua", "City1.lua", "Convoy1.lua", "Debug.lua", "TODO.lua", "Explosion.lua", "Coop_Convoy.lua";

end

