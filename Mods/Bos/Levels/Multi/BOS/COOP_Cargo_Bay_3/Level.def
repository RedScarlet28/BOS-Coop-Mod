-- COOP_Cargo_Bay_3: campaign mission Cargo_Bay_3 hosted as a multiplayer level (CoopMod, make_coop_level.py).
-- Scene = campaign scene + MP_Patrol spawn points / areas / idle cameras at the player start;
-- Events.kt3 = campaign trigger boxes + MP_Patrol's two spawn sectors; Coop_Cargo_Bay_3.lua = co-op adjustments.
DEF_FirstSubLevel = "SubLevel_0"

----------------------------------------------------
--							DEF_GetSubLevelFiles  							
----------------------------------------------------
function DEF_GetSubLevelFiles( SubLevelName )

	if (SubLevelName == "SubLevel_0")
	then
		return "Cargo_Bay_3\\Cargo_Bay_3.Kt3", "Cargo_Bay_3\\OBJ_DCA_OK.Kt3";
	end

end

----------------------------------------------------
--							DEF_GetLevelScriptFiles							
----------------------------------------------------
function DEF_GetLevelScriptFiles( )

	return "Cargo.lua", "Reload.lua", "Outside.lua", "Tunnel.lua", "Building.lua", "Debug.lua", "Objectives.lua", "MAIN.lua", "CAMP_cargo.lua", "VOnDerBroome.lua", "Coop_Cargo_Bay_3.lua";

end

