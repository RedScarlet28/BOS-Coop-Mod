-- COOP_Cargo_Bay_2: campaign mission Cargo_Bay_2 hosted as a multiplayer level (CoopMod, make_coop_level.py).
-- Scene = campaign scene + MP_Patrol spawn points / areas / idle cameras at the player start;
-- Events.kt3 = campaign trigger boxes + MP_Patrol's two spawn sectors; Coop_Cargo_Bay_2.lua = co-op adjustments.
DEF_FirstSubLevel = "SubLevel_0"

----------------------------------------------------
--							DEF_GetSubLevelFiles  							
----------------------------------------------------
function DEF_GetSubLevelFiles( SubLevelName )

	if (SubLevelName == "SubLevel_0")
	then
		return "Cargo_Bay_2\\Cargo_Bay_2.Kt3", "Cargo_Bay_2\\Cargo_Bay_2_OBJ_DCA.Kt3";
	end

end

----------------------------------------------------
--							DEF_GetLevelScriptFiles							
----------------------------------------------------
function DEF_GetLevelScriptFiles( )

	return "Main.lua", "Plain.lua", "ExoHouse.lua", "EndOfLevel.lua", "Debug.lua", "Coop_Cargo_Bay_2.lua";

end

