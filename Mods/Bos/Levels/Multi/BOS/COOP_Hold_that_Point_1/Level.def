-- COOP_Hold_that_Point_1: campaign mission Hold_that_Point_1 hosted as a multiplayer level (CoopMod, make_coop_level.py).
-- Scene = campaign scene + MP_Patrol spawn points / areas / idle cameras at the player start;
-- Events.kt3 = campaign trigger boxes + MP_Patrol's two spawn sectors; Coop_Hold_that_Point_1.lua = co-op adjustments.
DEF_FirstSubLevel = "SubLevel_0"

----------------------------------------------------
--							DEF_GetSubLevelFiles  							
----------------------------------------------------
function DEF_GetSubLevelFiles( SubLevelName )

	if (SubLevelName == "SubLevel_0")
	then
		return "Hold_that_Point_1\\Hold_that_Point_1.Kt3";
	end

end

----------------------------------------------------
--							DEF_GetLevelScriptFiles							
----------------------------------------------------
function DEF_GetLevelScriptFiles( )

	return "Main.lua", "Camp1.lua", "Camp2.lua", "Explosion.lua", "Suite1.lua", "Suite2.lua", "Debug.lua", "TODO.lua", "Cine_Begin.lua", "ConfigMerc.lua", "Coop_Hold_that_Point_1.lua";

end

