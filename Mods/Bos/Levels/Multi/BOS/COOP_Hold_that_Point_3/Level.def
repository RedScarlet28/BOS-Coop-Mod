-- COOP_Hold_that_Point_3: campaign mission Hold_that_Point_3 hosted as a multiplayer level (CoopMod, make_coop_level.py).
-- Scene = campaign scene + MP_Patrol spawn points / areas / idle cameras at the player start;
-- Events.kt3 = campaign trigger boxes + MP_Patrol's two spawn sectors; Coop_Hold_that_Point_3.lua = co-op adjustments.
DEF_FirstSubLevel = "SubLevel_0"

----------------------------------------------------
--							DEF_GetSubLevelFiles  							
----------------------------------------------------
function DEF_GetSubLevelFiles( SubLevelName )

	if (SubLevelName == "SubLevel_0")
	then
		return "Hold_that_Point_3\\Hold_that_Point_3.Kt3";
	end

end

----------------------------------------------------
--							DEF_GetLevelScriptFiles							
----------------------------------------------------
function DEF_GetLevelScriptFiles( )

	return "Main.lua", "TUNNEL.lua", "SCENE.lua", "Debug.lua", "OUTSIDE.lua", "Boss.lua", "Coop_Hold_that_Point_3.lua";

end

