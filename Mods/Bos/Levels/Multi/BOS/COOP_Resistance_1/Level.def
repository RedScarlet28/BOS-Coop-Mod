-- COOP_Resistance_1: campaign mission Resistance_1 hosted as a multiplayer level (CoopMod, make_coop_level.py).
-- Scene = campaign scene + MP_Patrol spawn points / areas / idle cameras at the player start;
-- Events.kt3 = campaign trigger boxes + MP_Patrol's two spawn sectors; Coop_Resistance_1.lua = co-op adjustments.
DEF_FirstSubLevel = "SubLevel_0"

----------------------------------------------------
--							DEF_GetSubLevelFiles  							
----------------------------------------------------
function DEF_GetSubLevelFiles( SubLevelName )

	if (SubLevelName == "SubLevel_0")
	then
		return "Resistance_1\\Resistance_1.Kt3";
	end

end

----------------------------------------------------
--							DEF_GetLevelScriptFiles							
----------------------------------------------------
function DEF_GetLevelScriptFiles( )

	return "EndOfLevel.lua", "Main.lua", "Debug.lua", "GAME.lua", "SEQUENCE.lua", "Ruines.lua", "HUBER.lua", "REMPARTS.lua", "FIN.lua", "TANK_GAMEPLAY.lua", "ConfigMerc.lua", "Coop_Resistance_1.lua";

end

