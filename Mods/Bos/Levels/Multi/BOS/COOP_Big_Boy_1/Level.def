-- COOP_Big_Boy_1: campaign mission Big_Boy_1 hosted as a multiplayer level (CoopMod, make_coop_level.py).
-- Scene = campaign scene + MP_Patrol spawn points / areas / idle cameras at the player start;
-- Events.kt3 = campaign trigger boxes + MP_Patrol's two spawn sectors; Coop_Big_Boy_1.lua = co-op adjustments.
DEF_FirstSubLevel = "SubLevel_0"

----------------------------------------------------
--							DEF_GetSubLevelFiles  							
----------------------------------------------------
function DEF_GetSubLevelFiles( SubLevelName )

	if (SubLevelName == "SubLevel_0")
	then
		return "Big_Boy_1\\Big Boy_01.Kt3";
	end

end

----------------------------------------------------
--							DEF_GetLevelScriptFiles							
----------------------------------------------------
function DEF_GetLevelScriptFiles( )

	return "Main.lua", "Explosion.lua", "Camp.lua", "Spot.lua", "Field.lua", "Debug.lua", "Cinematic.lua", "ConfigMerc.lua", "Coop_Big_Boy_1.lua";

end

